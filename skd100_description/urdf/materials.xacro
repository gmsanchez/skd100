<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <material name="White">
        <color rgba="1.0 1.0 1.0 1.0"/>
    </material>

    <material name="Green">
        <color rgba="0.0 1.0 0.0 1.0"/>
    </material>

    <material name="Yellow">
        <color rgba="1.0 1.0 0.0 1.0"/>
    </material>

    <material name="Pink">
        <color rgba="1.0 0.0 1.0 1.0"/>
    </material>

</robot>